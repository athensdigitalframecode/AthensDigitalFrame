{
  "headers": [
    {
      "source": "/((?!olivane/)(?!arclines/)(?!enuma/)(?!last-train/).*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; upgrade-insecure-requests"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=31536000; includeSubDomains"
        },
        {
          "key": "Cross-Origin-Opener-Policy",
          "value": "same-origin"
        }
      ]
    },
    {
      "source": "/(olivane|arclines|enuma|last-train)/(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; img-src 'self' data: blob:; font-src 'self' https://fonts.gstatic.com; connect-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; upgrade-insecure-requests"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=31536000; includeSubDomains"
        },
        {
          "key": "Cross-Origin-Opener-Policy",
          "value": "same-origin"
        }
      ]
    },
    {
      "source": "/fonts/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/assets/(site|cube|cube-gl|flag).(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/enuma-elish/:path*",
      "destination": "/enuma/",
      "permanent": true
    },
    {
      "source": "/enuma-elish/",
      "destination": "/enuma/",
      "permanent": true
    },
    {
      "source": "/:p(prices|privacy)",
      "destination": "/:p.html",
      "permanent": true
    },
    {
      "source": "/en/:p(prices|privacy)",
      "destination": "/en/:p.html",
      "permanent": true
    },
    {
      "source": "/work/:k(olivane|arclines|enuma|last-train)",
      "destination": "/work/:k.html",
      "permanent": true
    },
    {
      "source": "/en/work/:k(olivane|arclines|enuma|last-train)",
      "destination": "/en/work/:k.html",
      "permanent": true
    },
    {
      "source": "/work/enuma-elish.html",
      "destination": "/work/enuma.html",
      "permanent": true
    },
    {
      "source": "/en/work/enuma-elish.html",
      "destination": "/en/work/enuma.html",
      "permanent": true
    }
  ]
}
